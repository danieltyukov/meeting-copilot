{
  "manifest_version": 3,
  "name": "Sparky",
  "version": "0.5.1",
  "description": "A meeting copilot: a live transcript with named speakers, plus first-person answers and talking points (Meet, Teams).",
  "permissions": ["tabCapture", "sidePanel", "storage", "tabs", "downloads", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.deepgram.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Sparky (side panel)" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open Sparky on this tab"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
